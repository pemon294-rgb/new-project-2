---
import { toolsData, categoryInfo } from '../data/tools';

const categories = ['photo', 'signature', 'pdf'] as const;

// Group tools by category
const toolsByCategory: Record<string, typeof toolsData> = {};
for (const cat of categories) {
  toolsByCategory[cat] = toolsData.filter(t => t.category === cat);
}
---

<footer class="bg-white border-t-2 border-[#6B4A3A] mt-16 py-12">
  <div class="max-w-6xl mx-auto px-4">
    <!-- Footer Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-8 mb-12">
      <!-- Branding Column -->
      <div>
        <div class="text-lg font-bold mb-2" style="color: #6B4A3A; font-family: 'Lora', serif;">Kompress</div>
        <p class="text-sm text-gray-600">Fast, secure, browser-based tools for image and document optimization.</p>
      </div>

      <!-- Photo Tools -->
      <div>
        <h3 class="font-bold text-gray-800 mb-3" style="font-family: 'Lora', serif;">Photo Tools</h3>
        <ul class="space-y-2 text-sm">
          {toolsByCategory['photo'].map(tool => (
            <li>
              <a href={`/${tool.slug}`} class="text-gray-600 hover:text-[#6B4A3A] transition">
                {tool.title}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Signature Tools -->
      <div>
        <h3 class="font-bold text-gray-800 mb-3" style="font-family: 'Lora', serif;">Signature Tools</h3>
        <ul class="space-y-2 text-sm">
          {toolsByCategory['signature'].map(tool => (
            <li>
              <a href={`/${tool.slug}`} class="text-gray-600 hover:text-[#6B4A3A] transition">
                {tool.title}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- PDF Tools (Part 1) -->
      <div>
        <h3 class="font-bold text-gray-800 mb-3" style="font-family: 'Lora', serif;">PDF Tools</h3>
        <ul class="space-y-2 text-sm">
          {toolsByCategory['pdf'].slice(0, 8).map(tool => (
            <li>
              <a href={`/${tool.slug}`} class="text-gray-600 hover:text-[#6B4A3A] transition">
                {tool.title}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- PDF Tools (Part 2) & Legal -->
      <div>
        <ul class="space-y-2 text-sm mb-6">
          {toolsByCategory['pdf'].slice(8).map(tool => (
            <li>
              <a href={`/${tool.slug}`} class="text-gray-600 hover:text-[#6B4A3A] transition">
                {tool.title}
              </a>
            </li>
          ))}
        </ul>
        <h3 class="font-bold text-gray-800 mb-3" style="font-family: 'Lora', serif;">About</h3>
        <ul class="space-y-2 text-sm">
          <li><a href="/about" class="text-gray-600 hover:text-[#6B4A3A] transition">About</a></li>
          <li><a href="/contact" class="text-gray-600 hover:text-[#6B4A3A] transition">Contact</a></li>
          <li><a href="/privacy-policy" class="text-gray-600 hover:text-[#6B4A3A] transition">Privacy Policy</a></li>
          <li><a href="/terms" class="text-gray-600 hover:text-[#6B4A3A] transition">Terms</a></li>
        </ul>
      </div>
    </div>

    <!-- Bottom Footer -->
    <div class="border-t border-gray-200 pt-8 text-center text-sm text-gray-500">
      &copy; 2026 Kompress.io. All rights reserved.
    </div>
  </div>
</footer>
