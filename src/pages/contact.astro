---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Contact Us - Kompress.io" description="Contact the Kompress.io team.">
  <div class="max-w-3xl mx-auto px-4 py-12">
    <h1 class="text-3xl font-bold mb-6 text-gray-900">Contact</h1>
    <div class="prose prose-blue bg-white p-8 rounded-2xl shadow-sm border border-gray-100">
      <p>If you have any questions, suggestions, or issues while using our tools, please reach out.</p>
      <p class="text-lg font-medium">Email: <a href="mailto:hello@kompress.io" class="text-blue-600 no-underline hover:underline">hello@kompress.io</a></p>
      <p>We try to respond to all inquiries within 48 hours.</p>
    </div>
  </div>
</Layout>
