---
import Layout from '../layouts/Layout.astro';
import AdPlaceholder from '../components/AdPlaceholder.astro';
import ImageCompressor from '../components/tools/ImageCompressor';
import ImageResizer from '../components/tools/ImageResizer';
import ImageConverter from '../components/tools/ImageConverter';
import JpgToPdf from '../components/tools/JpgToPdf';
import MergePdf from '../components/tools/MergePdf';
import SplitPdf from '../components/tools/SplitPdf';
import CompressPdf from '../components/tools/CompressPdf';
import RotatePdf from '../components/tools/RotatePdf';
import RemovePages from '../components/tools/RemovePages';
import ExtractPages from '../components/tools/ExtractPages';
import AddPageNumbers from '../components/tools/AddPageNumbers';
import AddWatermark from '../components/tools/AddWatermark';
import OrganizePdf from '../components/tools/OrganizePdf';
import CropPdf from '../components/tools/CropPdf';
import { toolsData } from '../data/tools';

export function getStaticPaths() {
  return toolsData.map((tool) => ({
    params: { slug: tool.slug },
    props: { tool },
  }));
}

const { tool } = Astro.props;
---

<Layout title={tool.title} description={tool.description}>
  <div class="max-w-4xl mx-auto px-4 py-8">
    <AdPlaceholder className="mb-8" />

    <div class="text-center mb-8">
      <h1 class="text-3xl md:text-4xl font-bold text-gray-900 mb-3">{tool.title}</h1>
      <p class="text-lg text-gray-600 max-w-2xl mx-auto">{tool.description}</p>
    </div>

    <!-- Tool Component loaded on client -->
    <div class="mb-12">
      {tool.type === 'compressor' && tool.targetKB && (
        <ImageCompressor targetKB={tool.targetKB} client:load />
      )}
      {tool.type === 'compressor' && !tool.targetKB && tool.category === 'photo' && (
        <ImageConverter client:load />
      )}
      {tool.type === 'compressor' && !tool.targetKB && tool.category === 'pdf' && tool.slug.startsWith('convert') && (
        <JpgToPdf client:load />
      )}
      {tool.type === 'compressor' && !tool.targetKB && tool.category === 'pdf' && tool.slug.startsWith('merge') && (
        <MergePdf client:load />
      )}
      {tool.type === 'compressor' && !tool.targetKB && tool.category === 'pdf' && tool.slug.startsWith('split') && (
        <SplitPdf client:load />
      )}
      {tool.type === 'compressor' && !tool.targetKB && tool.category === 'pdf' && tool.slug.startsWith('rotate') && (
        <RotatePdf client:load />
      )}
      {tool.type === 'compressor' && !tool.targetKB && tool.category === 'pdf' && tool.slug.startsWith('fix-sideways') && (
        <RotatePdf client:load />
      )}
      {tool.type === 'compressor' && !tool.targetKB && tool.category === 'pdf' && tool.slug.startsWith('remove') && (
        <RemovePages client:load />
      )}
      {tool.type === 'compressor' && !tool.targetKB && tool.category === 'pdf' && tool.slug.startsWith('delete') && (
        <RemovePages client:load />
      )}
      {tool.type === 'compressor' && !tool.targetKB && tool.category === 'pdf' && tool.slug.startsWith('extract') && (
        <ExtractPages client:load />
      )}
      {tool.type === 'compressor' && !tool.targetKB && tool.category === 'pdf' && tool.slug.startsWith('save-specific') && (
        <ExtractPages client:load />
      )}
      {tool.type === 'compressor' && !tool.targetKB && tool.category === 'pdf' && tool.slug.startsWith('add-page') && (
        <AddPageNumbers client:load />
      )}
      {tool.type === 'compressor' && !tool.targetKB && tool.category === 'pdf' && tool.slug.startsWith('insert-page') && (
        <AddPageNumbers client:load />
      )}
      {tool.type === 'compressor' && !tool.targetKB && tool.category === 'pdf' && tool.slug.startsWith('add-watermark') && (
        <AddWatermark client:load />
      )}
      {tool.type === 'compressor' && !tool.targetKB && tool.category === 'pdf' && tool.slug.startsWith('add-text-watermark') && (
        <AddWatermark client:load />
      )}
      {tool.type === 'compressor' && !tool.targetKB && tool.category === 'pdf' && tool.slug.startsWith('add-logo') && (
        <AddWatermark client:load />
      )}
      {tool.type === 'compressor' && !tool.targetKB && tool.category === 'pdf' && tool.slug.startsWith('organize') && (
        <OrganizePdf client:load />
      )}
      {tool.type === 'compressor' && !tool.targetKB && tool.category === 'pdf' && tool.slug.startsWith('reorder') && (
        <OrganizePdf client:load />
      )}
      {tool.type === 'compressor' && !tool.targetKB && tool.category === 'pdf' && tool.slug.startsWith('crop') && (
        <CropPdf client:load />
      )}
      {tool.type === 'compressor' && !tool.targetKB && tool.category === 'pdf' && tool.slug.startsWith('remove-margins') && (
        <CropPdf client:load />
      )}
      {tool.type === 'compressor' && tool.targetKB && tool.category === 'pdf' && (
        <CompressPdf targetKB={tool.targetKB} client:load />
      )}
      {tool.type === 'resizer' && (
        <ImageResizer defaultMode={tool.defaultMode} defaultPreset={tool.defaultPreset} client:load />
      )}
      {tool.type === 'signature' && (
        <div class="text-center text-gray-500 p-8">Signature tool placeholder</div>
      )}
    </div>

    <AdPlaceholder className="mb-12" />

    <article class="prose prose-blue max-w-none mb-12 bg-white p-6 rounded-2xl shadow-sm border border-gray-100">
      <h2 class="text-2xl font-bold text-gray-800 mb-4 border-b pb-2">Guide</h2>
      <p class="text-gray-700 leading-relaxed">{tool.guideText}</p>
    </article>

    <div class="mb-12 bg-white p-6 rounded-2xl shadow-sm border border-gray-100">
      <h2 class="text-2xl font-bold text-gray-800 mb-6 border-b pb-2">Frequently Asked Questions</h2>
      <div class="space-y-6">
        {tool.faqs.map((faq) => (
          <div>
            <h3 class="text-lg font-semibold text-gray-800 mb-2">{faq.question}</h3>
            <p class="text-gray-600">{faq.answer}</p>
          </div>
        ))}
      </div>
    </div>

    <AdPlaceholder className="mt-8" />

    <div class="mt-8 mb-4 border-t pt-8">
      <h3 class="text-xl font-bold text-gray-800 mb-4">Related Tools</h3>
      <div class="flex flex-wrap gap-3">
        {toolsData.filter(t => t.slug !== tool.slug && t.category === tool.category).slice(0, 5).map(t => (
          <a href={`/${t.slug}`} class="bg-gray-100 hover:bg-gray-200 text-gray-700 px-4 py-2 rounded-full text-sm font-medium transition">
            {t.title}
          </a>
        ))}
      </div>
    </div>
  </div>
</Layout>


